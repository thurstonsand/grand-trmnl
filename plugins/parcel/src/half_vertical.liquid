{% if success == false %}
  {% render "error_state", error_message: error_message, title_class: "title title--small lg:title--base" %}
{% elsif deliveries.size == 0 %}
  {% render "empty_state", title_class: "title title--small lg:title--base" %}
{% else %}
  <div class="layout layout--col layout--start layout--stretch-x gap--small lg:gap--medium">
    <div class="w--full border--h-black pb--1">
      {% render "hero_slot", all_arrived: all_arrived, today_indices_arr: today_indices_arr, deliveries: deliveries, delivered_count: delivered_indices_arr.size, hero_idx: hero_idx, hero: hero, hero_date_expected: hero_date_expected, hero_days: hero_days, hero_late: hero_late, today_date: today_date, today_epoch: today_epoch, label_class: "label--small lg:label--base", days_value_class: "value lg:value--large", name_class: "title lg:title--large", detail_class: "description lg:description--large", event_class: "description lg:description--base text--gray-25 4bit:text--gray-50", date_format: "%A, %b %-d", today_cap: 4, show_hero_location: true, show_all_arrived_detail: false, today_show_status: true, today_show_location: false %}
    </div>

    {% if upcoming_indices_arr.size > 0 or delivered_indices_arr.size > 0 %}
      {% assign manifest_count = upcoming_indices_arr.size | plus: delivered_indices_arr.size %}
      {% assign row_position = 0 %}
      <div class="grid grid--cols-1 lg:grid--cols-2 lg:portrait:grid--cols-1 gap--xsmall">
        {% for idx_str in upcoming_indices_arr %}
          {% if row_position < 8 %}
            {% assign idx = idx_str | plus: 0 %}
            {% assign d = deliveries[idx] %}
            {% assign row_class = "" %}
            {% if row_position >= 6 %}{% assign row_class = "hidden lg:block lg:portrait:hidden" %}{% endif %}
            {% render "manifest_row", d: d, today_date: today_date, today_epoch: today_epoch, row_class: row_class, show_status: true, show_location: false, show_latest_event: true %}
          {% endif %}
          {% assign row_position = row_position | plus: 1 %}
        {% endfor %}
        {% for idx_str in delivered_indices_arr %}
          {% if row_position < 8 %}
            {% assign idx = idx_str | plus: 0 %}
            {% assign d = deliveries[idx] %}
            {% assign row_class = "" %}
            {% if row_position >= 6 %}{% assign row_class = "hidden lg:block lg:portrait:hidden" %}{% endif %}
            {% render "manifest_row", d: d, today_date: today_date, today_epoch: today_epoch, row_class: row_class, show_status: true, show_location: false, show_latest_event: true %}
          {% endif %}
          {% assign row_position = row_position | plus: 1 %}
        {% endfor %}
        {% if manifest_count > 6 %}
          {% assign compact_hidden_count = manifest_count | minus: 6 %}
          {% render "manifest_counter", count: compact_hidden_count, counter_class: "lg:hidden" %}
          {% render "manifest_counter", count: compact_hidden_count, counter_class: "hidden portrait:block" %}
        {% endif %}
        {% if manifest_count > 8 %}
          {% assign x_hidden_count = manifest_count | minus: 8 %}
          {% render "manifest_counter", count: x_hidden_count, counter_class: "hidden lg:block lg:portrait:hidden" %}
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="title_bar">
    <span class="title">Parcels</span>
    <span class="instance">{{ deliveries.size }} tracked</span>
  </div>
{% endif %}
