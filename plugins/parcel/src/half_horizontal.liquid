{% if success == false %}
  {% render "error_state", error_message: error_message, title_class: "title title--small lg:title--base", bin_when: bin_when, bin_recycling: bin_recycling %}
{% elsif deliveries.size == 0 %}
  {% render "empty_state", title_class: "title title--small lg:title--base", bin_when: bin_when, bin_recycling: bin_recycling %}
{% else %}
  {% assign has_upcoming_region = false %}
  {% if upcoming_indices_arr.size > 0 or bin_when == "tonight" %}{% assign has_upcoming_region = true %}{% endif %}

  {% capture left_rows %}
    {% for idx_str in today_indices_arr %}
      {% assign idx = idx_str | plus: 0 %}
      {% assign d = deliveries[idx] %}
      {% render "manifest_row", d: d, today_date: today_date, today_epoch: today_epoch, show_status: true, show_location: false, show_latest_event: true, hide_indicator: true %}
    {% endfor %}
    {% if bin_when == "today" %}{% render "bin_row", recycling: bin_recycling, when: bin_when, title_class: "title title--small lg:title--base", row_class: "p--1 lg:p--2" %}{% endif %}
    {% for idx_str in delivered_indices_arr %}
      {% assign idx = idx_str | plus: 0 %}
      {% assign d = deliveries[idx] %}
      {% render "manifest_row", d: d, today_date: today_date, today_epoch: today_epoch, show_status: false, show_location: false, show_latest_event: true %}
    {% endfor %}
  {% endcapture %}

  {% capture right_rows %}
    {% if bin_when == "tonight" %}{% render "bin_row", recycling: bin_recycling, when: bin_when, title_class: "title title--small lg:title--base", row_class: "p--1 lg:p--2 mb--1" %}{% endif %}
    {% for idx_str in upcoming_indices_arr %}
      {% assign idx = idx_str | plus: 0 %}
      {% assign d = deliveries[idx] %}
      {% render "manifest_row", d: d, today_date: today_date, today_epoch: today_epoch, show_status: true, show_location: false, show_latest_event: true %}
    {% endfor %}
  {% endcapture %}

  <div class="layout layout--row portrait:layout--col layout--start layout--stretch-y gap--small lg:gap--medium">
    <div class="{% if has_upcoming_region %}grow w--0 portrait:w--full{% else %}w--full{% endif %} h--min-0">
      {% render "hero_slot", all_arrived: all_arrived, today_indices_arr: today_indices_arr, delivered_count: delivered_indices_arr.size, hero_idx: hero_idx, hero: hero, hero_date_expected: hero_date_expected, hero_days: hero_days, hero_late: hero_late, label_class: "label--small lg:label--base", days_value_class: "value lg:value--large", name_class: "title lg:title--large", detail_class: "description lg:description--large", event_class: "hidden", date_format: "%b %-d", show_hero_location: true, show_all_arrived_detail: false %}

      {% if today_indices_arr.size > 0 or bin_when == "today" or delivered_indices_arr.size > 0 %}
        <div class="columns border--h-black mt--1 pt--1{% if has_upcoming_region %} portrait:hidden{% endif %}" data-overflow-cols="1" data-overflow-counter="true">
          <div class="column flex--col flex--start">{{ left_rows }}</div>
        </div>
      {% endif %}

      {% if has_upcoming_region %}
        <div class="columns landscape:hidden border--h-black mt--1 pt--1" data-overflow-cols="1" data-overflow-counter="true">
          <div class="column flex--col flex--start">{{ left_rows }}{{ right_rows }}</div>
        </div>
      {% endif %}
    </div>

    {% if has_upcoming_region %}
      <div class="h--full border--v-black portrait:hidden"></div>
      <div class="grow w--0 portrait:hidden">
        <div class="columns" data-overflow-cols="1" data-overflow-cols-lg="2" data-overflow-counter="true">
          <div class="column flex--col flex--start">{{ right_rows }}</div>
        </div>
      </div>
    {% endif %}
  </div>

  <div class="title_bar">
    <span class="title">Parcels</span>
    <span class="instance">{{ deliveries.size }} tracked</span>
  </div>
{% endif %}
