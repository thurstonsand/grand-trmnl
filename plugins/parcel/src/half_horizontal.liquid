{% if success == false %}
  {% render "error_state", error_message: error_message, title_class: "title title--small lg:title--base" %}
{% elsif deliveries.size == 0 %}
  {% render "empty_state", title_class: "title title--small lg:title--base" %}
{% else %}
  <div class="layout layout--row portrait:layout--col layout--start layout--stretch-y gap--small lg:gap--medium">
    <div class="{% if upcoming_indices_arr.size > 0 %}landscape:grow landscape:w--0 portrait:w--full{% else %}w--full{% endif %}">
      {% render "hero_slot", all_arrived: all_arrived, today_indices_arr: today_indices_arr, deliveries: deliveries, delivered_count: delivered_indices_arr.size, hero_idx: hero_idx, hero: hero, hero_date_expected: hero_date_expected, hero_days: hero_days, hero_late: hero_late, today_date: today_date, today_epoch: today_epoch, label_class: "label--small lg:label--base", days_value_class: "value lg:value--large", name_class: "title lg:title--large", detail_class: "description lg:description--large", event_class: "hidden", date_format: "%b %-d", today_cap: 3, show_hero_location: true, show_all_arrived_detail: false, today_show_status: true, today_show_location: false %}

      {% if delivered_indices_arr.size > 0 %}
        <div class="border--h-black mt--1 pt--1">
          {% for idx_str in delivered_indices_arr limit: 2 %}
            {% assign idx = idx_str | plus: 0 %}
            {% assign d = deliveries[idx] %}
            {% render "manifest_row", d: d, today_date: today_date, today_epoch: today_epoch, row_class: "py--0.5", show_status: false, show_location: false, show_latest_event: true %}
          {% endfor %}
          {% if delivered_indices_arr.size > 2 %}
            {% assign delivered_hidden_count = delivered_indices_arr.size | minus: 2 %}
            {% render "manifest_counter", count: delivered_hidden_count, counter_class: "py--0.5" %}
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if upcoming_indices_arr.size > 0 %}
      <div class="h--full border--v-black portrait:hidden"></div>
      <div class="hidden portrait:block w--full border--h-black"></div>
      <div class="landscape:grow landscape:w--0 portrait:grow portrait:h--0 portrait:w--full">
        <div class="grid grid--cols-1 lg:grid--cols-2 lg:portrait:grid--cols-1 gap--xsmall">
          {% for idx_str in upcoming_indices_arr limit: 6 %}
            {% assign idx = idx_str | plus: 0 %}
            {% assign d = deliveries[idx] %}
            {% assign row_class = "py--0.5" %}
            {% if forloop.index0 >= 3 %}{% assign row_class = "py--0.5 hidden lg:block lg:portrait:hidden" %}{% endif %}
            {% render "manifest_row", d: d, today_date: today_date, today_epoch: today_epoch, row_class: row_class, show_status: true, show_location: false, show_latest_event: true %}
          {% endfor %}
          {% if upcoming_indices_arr.size > 3 %}
            {% assign compact_hidden_count = upcoming_indices_arr.size | minus: 3 %}
            {% render "manifest_counter", count: compact_hidden_count, counter_class: "lg:hidden" %}
            {% render "manifest_counter", count: compact_hidden_count, counter_class: "hidden portrait:block" %}
          {% endif %}
          {% if upcoming_indices_arr.size > 6 %}
            {% assign x_hidden_count = upcoming_indices_arr.size | minus: 6 %}
            {% render "manifest_counter", count: x_hidden_count, counter_class: "hidden lg:block lg:portrait:hidden" %}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="title_bar">
    <span class="title">Parcels</span>
    <span class="instance">{{ deliveries.size }} tracked</span>
  </div>
{% endif %}
