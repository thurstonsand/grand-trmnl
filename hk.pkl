amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        steps {
            ["lint"] {
                check = "mise run lint"
                exclusive = true
            }
            ["test"] {
                check = "mise run test"
                exclusive = true
            }
        }
    }
}
