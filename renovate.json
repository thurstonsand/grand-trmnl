{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":maintainLockFilesWeekly",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#]+#/(?<depType>Config|Builtins)\\.pkl"
      ],
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/{{{depType}}}.pkl"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["jdx/hk"],
      "groupName": "hk",
      "groupSlug": "hk"
    },
    {
      "description": "mise keeps the dependency graph behind each npm tool in mise.lock and mise.renovate.lock under .mise/locks, and Renovate's mise manager regenerates it with each bump. Left on, the npm manager would also bump those package.json files alone, out of step with their aube-lock.yaml and the lock's digest",
      "matchFileNames": [".mise/locks/**"],
      "enabled": false
    }
  ]
}
