#!/usr/bin/env bash
#MISE description="Start local JSON server and trmnlp preview"

cleanup() {
  if [ -n "$JSON_PID" ]; then
    kill "$JSON_PID" 2>/dev/null
    wait "$JSON_PID" 2>/dev/null
  fi
  if [ -n "$TRMNLP_PID" ]; then
    kill "$TRMNLP_PID" 2>/dev/null
    wait "$TRMNLP_PID" 2>/dev/null
  fi
}

trap cleanup EXIT INT TERM

python3 -m http.server 8888 --directory references &
JSON_PID=$!

trmnlp serve &
TRMNLP_PID=$!

echo "JSON server: http://localhost:8888"
echo "trmnlp preview: http://localhost:4567"
echo "Press Ctrl+C to stop both"

wait
